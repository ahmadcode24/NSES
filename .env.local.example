# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nses?retryWrites=true&w=majority

# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Admin Credentials (single admin account)
ADMIN_USERNAME=admin
# Generate bcrypt hash: e.g. bcryptjs.hashSync('your_password', 10)
ADMIN_PASSWORD_HASH=$2a$10$YourBcryptPasswordHashHere

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Base Site URL used for generating QR codes and profile URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
